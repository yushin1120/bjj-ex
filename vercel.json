{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/job-test",
      "destination": "/job-test/index.html"
    },
    {
      "source": "/job-test/(.*)",
      "destination": "/job-test/$1"
    },
    {
      "source": "/",
      "destination": "/주짓수게임/index.html"
    }
  ]
}
